# REQUIRED
SEC_USER_AGENT=claude-insider-screener your@email.com
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Persistent storage (on Railway mount a Volume at /data)
DATA_DIR=./data

# Optional tuning (defaults shown)
POLL_MINUTES=15
WINDOW_DAYS=14
MIN_TOTAL_USD=500000
MIN_INSIDERS=2
EXCEPTIONAL_SINGLE_USD=1000000
MIN_PRICE=5
MIN_ADV_USD=5000000
MIN_MCAP=200000000
MAX_MCAP=10000000000
MAX_RUNUP_20D=0.25
MAX_RUNUP_60D=0.40
MAX_ABOVE_INSIDER_PRICE=0.15
MIN_SCORE=60
INCLUDE_TEN_PCT_OWNERS=false

# Schedule: Mon-Fri 05:00-21:00 Central, skipping US federal holidays (DST-aware)
SCHEDULE_TZ=America/Chicago
ACTIVE_START=05:00
ACTIVE_END=21:00
ACTIVE_DAYS=0,1,2,3,4
ENFORCE_SCHEDULE=true
HONOR_HOLIDAYS=true

# Offering watch / fresh prices / outcome tracking (defaults shown)
OFFERING_CHECK=true
OFFERING_ACTION=flag        # flag = send alert with a warning, hold = don't send if an offering is detected
OFFERING_WATCH_DAYS=30
EXT_MOVE_WARN=0.05
TRACK_OUTCOMES=true

# ---- v2: extra signals / confluence (defaults shown) ----
SIGNALS_MODE=shadow          # shadow = log only | boost = add points | require = need confirming signal(s)
SIGNALS_ENABLED=activist,earnings_drift,events
MIN_CONFIRMING_SIGNALS=1
MAX_ALERTS_PER_DAY=3         # 0 = unlimited
NEAR_MISS_MARGIN=20          # evaluate signals / log candidates down to MIN_SCORE minus this
BENCHMARK=SPY
ACTIVIST_LOOKBACK_DAYS=30
ACTIVIST_POINTS=10
DRIFT_POINTS=8
DRIFT_WINDOW_DAYS=45
DRIFT_MIN_SURPRISE=0.10
DRIFT_MIN_GAP=0.03
DRIFT_HOLD_TOL=0.03
DRIFT_MIN_VOL_RATIO=1.5

# ---- v2: optional AI review of finalists (off by default) ----
AI_MODE=off                  # off | shadow | veto
LLM_API_KEY=
LLM_MODEL=                   # exact model id from your provider's docs
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=             # leave blank unless your model accepts it
AI_VETO_MIN_CONF=0.6
AI_LOOKBACK_DAYS=30
AI_MAX_FILINGS=2
AI_MAX_DOC_CHARS=4000

# ---- v2: Telegram buttons + /pause /resume /status ----
TELEGRAM_CONTROL=true

# ---- 8-K screening ----
EVENTS_ENABLED=true
# Tags that send their own alert. All tags: fda_approval, fda_milestone, fda_negative, gov_contract, agreement,
# acquisition, earnings, exec_change, bankruptcy, non_reliance, dilution, financing
EVENT_ALERT_TAGS=fda_approval,fda_milestone,fda_negative,gov_contract,agreement,acquisition,exec_change,bankruptcy,non_reliance
EVENT_MIN_PRICE=3
EVENT_MIN_ADV_USD=2000000
EVENT_MIN_MCAP=100000000
EVENT_MAX_MCAP=20000000000   # 0 = no maximum
EVENTS_LOOKBACK_DAYS=30      # 8-K/contract/FDA news shown on and scored for insider alerts
MAX_EVENT_ALERTS_PER_DAY=15  # 8-K + contract + FDA alerts combined; 0 = unlimited
EVENTS_CHAT_ID=              # optional: send these to a different Telegram chat; blank = same chat
EVENTS_POINTS_CAP=15         # max points the 'events' signal adds to an insider alert (boost/require modes)

# ---- Government contracts + FDA approvals ----
FEEDS_ENABLED=dod,usaspending,openfda
CONTRACT_MIN_USD=10000000
CONTRACT_MIN_PCT_MCAP=0.01   # award must be >= 1% of the company's market cap
DOD_CONTRACTS_URL=https://www.war.gov/Newsroom/Contracts/
DOD_POLL_MINUTES=60
USASPENDING_POLL_MINUTES=360
FDA_POLL_MINUTES=360
FDA_LOOKBACK_DAYS=14
FDA_MAX_MCAP=50000000000     # one approval rarely moves a mega-cap; 0 = no maximum
NAME_MATCH_CUTOFF=0.92       # company-name matching strictness (0-1)
WEB_USER_AGENT=              # blank = SEC_USER_AGENT; set a browser user-agent if defense.gov returns 403
